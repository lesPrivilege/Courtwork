diff --git a/app/web/preview-seats.mjs b/app/web/preview-seats.mjs
new file mode 100644
index 0000000..4fcd305
--- /dev/null
+++ b/app/web/preview-seats.mjs
@@ -0,0 +1,30 @@
+// UI reading seats only. Identity is supplied by the existing file contract;
+// keeping a seat does not pin an artifact, write bytes or accept a review.
+export function createPreviewSeats(keyOf) {
+  let scope = null, current = null, transient = null;
+  const seats = new Map();
+  function clear() { seats.clear(); scope = null; current = null; transient = null; }
+  function open(ref) {
+    if (!ref?.sessionId) throw new Error('A preview needs a session identity');
+    if (scope !== ref.sessionId) { clear(); scope = ref.sessionId; }
+    const key = keyOf(ref);
+    if (!key) throw new Error('A preview needs a file identity');
+    if (!seats.has(key)) {
+      if (transient) seats.delete(transient);
+      seats.set(key, { key, ref: structuredClone(ref), kept: false }); transient = key;
+    }
+    current = key; return selected();
+  }
+  function selected() { return seats.has(current) ? structuredClone(seats.get(current)) : null; }
+  return { open, clear, selected,
+    list() { return [...seats.values()].map(seat => structuredClone(seat)); },
+    select(key) { if (!seats.has(key)) return null; current = key; return selected(); },
+    keep(key = current) { const seat = seats.get(key); if (!seat) return false; seat.kept = true; if (transient === key) transient = null; return true; },
+    close(key = current) {
+      const keys = [...seats.keys()], index = keys.indexOf(key); if (index < 0) return selected();
+      seats.delete(key); if (transient === key) transient = null;
+      if (current === key) current = [...seats.keys()][Math.min(index, seats.size - 1)] || null;
+      return selected();
+    },
+  };
+}
diff --git a/app/tests/preview-seats.test.mjs b/app/tests/preview-seats.test.mjs
new file mode 100644
index 0000000..72622ac
--- /dev/null
+++ b/app/tests/preview-seats.test.mjs
@@ -0,0 +1,23 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createPreviewSeats} from '../web/preview-seats.mjs';
+const key = ref => [ref.sessionId,ref.path,ref.kind,ref.sha256].join(':');
+const ref = (path,sha256='v1',sessionId='a') => ({sessionId,path,sha256,kind:'artifact',runId:'r'});
+test('one transient preview is replaced; explicit kept versions survive', () => {
+  const seats=createPreviewSeats(key);
+  seats.open(ref('one')); seats.open(ref('two')); assert.deepEqual(seats.list().map(s=>s.ref.path),['two']);
+  seats.keep(); seats.open(ref('three')); seats.open(ref('four'));
+  assert.deepEqual(seats.list().map(s=>[s.ref.path,s.kept]),[['two',true],['four',false]]);
+  seats.open(ref('two')); assert.equal(seats.selected().kept,true); assert.equal(seats.list().length,2);
+  seats.open(ref('two','v2')); assert.deepEqual(seats.list().map(s=>s.ref.sha256),['v1','v2']);
+  const returned=seats.selected();returned.ref.sha256='changed';assert.equal(seats.selected().ref.sha256,'v2');
+});
+test('closing only removes a seat; neighboring selection and scope reset are explicit', () => {
+  const seats=createPreviewSeats(key);const a=ref('one'),b=ref('two');
+  seats.open(a);seats.keep();seats.open(b);seats.keep();
+  seats.select(key(a));assert.equal(seats.close().ref.path,'two');assert.deepEqual(a,ref('one'));
+  assert.equal(seats.close(),null);assert.equal(seats.list().length,0);
+  seats.open(a);seats.keep();seats.open(ref('other','v1','b'));
+  assert.equal(seats.list().length,1);assert.equal(seats.select(key(a)),null);
+  seats.clear();assert.equal(seats.selected(),null);assert.equal(seats.list().length,0);
+});
