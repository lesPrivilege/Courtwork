{
  "name": "@courtwork/pi-lane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run --root ../.. src/*.test.ts",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "build:product-sidecar": "node scripts/build-product-sidecar.mjs",
    "test:product-sidecar": "node --test scripts/build-product-sidecar.test.mjs",
    "gate:verified-node-production": "node scripts/verified-node-gate.mjs production",
    "gate:verified-node-control": "node scripts/verified-node-gate.mjs control",
    "dev": "tsx src/sidecar-main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6"
  }
}
