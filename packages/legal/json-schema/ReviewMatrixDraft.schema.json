{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "answers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "quoteClaims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fileId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "page": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "blockId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "exactQuote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "fileId",
                      "exactQuote"
                    ],
                    "additionalProperties": false,
                    "title": "QuoteClaim",
                    "description": "模型侧引语声明：文件 + 页/块 + 精确引语。不承载坐标——坐标由 resolver 铸造。"
                  }
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              },
              "required": [
                "answer",
                "quoteClaims",
                "confidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "documentId",
          "answers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "caseId",
    "questions",
    "rows"
  ],
  "additionalProperties": false,
  "title": "ReviewMatrixDraft",
  "description": "矩阵审阅草稿（模型侧）：格只携文件+页/块+逐字引语；坐标由 resolver 公证铸造。",
  "$id": "urn:courtwork:schema:legal.ReviewMatrixDraft:v1"
}
